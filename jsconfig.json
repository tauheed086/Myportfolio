{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["app/**/*", "components/**/*", "lib/**/*", "db/**/*", "worker/**/*", "build/**/*", "*.js", "*.mjs"],
  "exclude": ["node_modules", "dist", ".vinext", ".wrangler", "outputs", "zentra-git-backup"]
}
